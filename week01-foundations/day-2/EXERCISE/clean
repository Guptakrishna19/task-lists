def double_positives(numbers: list[float]) -> list[float]:
    """Return a new list with each positive number doubled; negatives/zeros dropped.

    Args:
        numbers: A list of numeric values to process.

    Returns:
        A list containing only the positive values from *numbers*, each multiplied by 2.

    Examples:
        >>> double_positives([1, -2, 3, 0, 4])
        [2, 6, 8]
        >>> double_positives([])
        []
    """
    return [n * 2 for n in numbers if n > 0]


def calculate(a: float, b: float, op: str) -> float | None:
    """Perform a basic arithmetic operation on two numbers.

    Args:
        a: The left-hand operand.
        b: The right-hand operand.
        op: One of ``"add"``, ``"sub"``, ``"mul"``, or ``"div"``.

    Returns:
        The result of the operation, or ``None`` if *op* is ``"div"`` and *b*
        is zero (avoids ZeroDivisionError).

    Raises:
        ValueError: If *op* is not one of the four supported strings.

    Examples:
        >>> calculate(10, 2, "div")
        5.0
        >>> calculate(10, 0, "div") is None
        True
    """
    match op:
        case "add":
            return a + b
        case "sub":
            return a - b
        case "mul":
            return a * b
        case "div":
            return a / b if b != 0 else None
        case _:
            raise ValueError(f"Unsupported operator {op!r}. Choose add/sub/mul/div.")


def get_full_name(person: dict[str, str]) -> str:
    """Build a full name string from a dict with ``first`` and ``last`` keys.

    Args:
        person: A dictionary that must contain ``"first"`` and ``"last"`` keys.

    Returns:
        A single string in ``"First Last"`` format.

    Raises:
        KeyError: If either ``"first"`` or ``"last"`` is missing from *person*.

    Examples:
        >>> get_full_name({"first": "Ada", "last": "Lovelace"})
        'Ada Lovelace'
    """
    return f"{person['first']} {person['last']}"


def contains(value: object, collection: list) -> bool:
    """Check whether *value* appears in *collection*.

    Prefer the built-in ``in`` operator for production code; this exists as a
    readable, explicit teaching example.

    Args:
        value: The item to search for.
        collection: The list to search within.

    Returns:
        ``True`` if *value* is found, ``False`` otherwise.

    Examples:
        >>> contains("b", ["a", "b", "c"])
        True
        >>> contains("z", [])
        False
    """
    return any(item == value for item in collection)


def count_words(text: str) -> dict[str, int]:
    """Count the frequency of each whitespace-separated word in *text*.

    Comparison is case-sensitive; punctuation is not stripped.

    Args:
        text: The input string to analyse.

    Returns:
        A dictionary mapping each unique word to its occurrence count.

    Examples:
        >>> count_words("the cat sat on the mat")
        {'the': 2, 'cat': 1, 'sat': 1, 'on': 1, 'mat': 1}
        >>> count_words("")
        {}
    """
    counts: dict[str, int] = {}
    for word in text.split():
        counts[word] = counts.get(word, 0) + 1
    return counts


