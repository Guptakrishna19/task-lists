def summarise(*args: float, label: str = "Total", **kwargs: str) -> str:
    """Demonstrate *args / **kwargs patterns.

    Args:
        *args:   Any number of numeric values to sum.
        label:   Keyword-only label prefix (default ``"Total"``).
        **kwargs: Arbitrary extra string metadata included in the output.

    Returns:
        A formatted summary string.

    Examples:
        >>> summarise(1, 2, 3, label="Sum")
        'Sum: 6.0'
        >>> summarise(10, 20, note="draft")
        'Total: 30.0 | note=draft'
    """
    total = sum(args)
    meta = " | ".join(f"{k}={v}" for k, v in kwargs.items())
    base = f"{label}: {total}"
    return f"{base} | {meta}" if meta else base


