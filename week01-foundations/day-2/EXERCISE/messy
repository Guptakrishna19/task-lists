def f(l):  
    r = []
    for i in l:
        if i > 0:
            r.append(i * 2)
    return r
 
 # 2
def calc(a, b, op):
    if op == "add":
        return a + b
    elif op == "sub":
        return a - b
    elif op == "mul":
        return a * b
    elif op == "div":
        if b != 0:
            return a / b
        else:
            return None
 
